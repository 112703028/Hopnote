{
  "name": "pc-to-ipad",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "../pwa/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/room/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
